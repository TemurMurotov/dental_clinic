# PostgreSQL connection string (Vercel Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin session JWT secret — generate with: openssl rand -base64 32
SESSION_SECRET=""

# Public site URL (used in sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL="https://example.com"

# Vercel Blob token for image uploads (added automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=""

# Initial admin account, used only by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
